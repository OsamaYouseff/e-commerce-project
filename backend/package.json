{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "nodemon index.js",
    "start:prod": "node index.js",
    "test": "node --test test/",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:rollback": "node-pg-migrate down -m db/migrations",
    "db:status": "node src/scripts/migration/migration-status.js",
    "db:create": "node-pg-migrate create -m db/migrations",
    "db:preview": "node src/scripts/migration/import-mongo.js",
    "db:import": "node src/scripts/migration/import-mongo.js --insert --force",
    "db:import:reset": "node src/scripts/migration/import-mongo.js --insert --reset --force",
    "db:reconcile": "node src/scripts/migration/reconcile-import.js",
    "db:backup": "node src/scripts/migration/backup-db.js",
    "db:restore": "node src/scripts/migration/restore-db.js",
    "db:reinit:local": "node src/scripts/migration/reinit-local.js",
    "db:reinit:local:import": "node src/scripts/migration/reinit-local.js --import",
    "db:export:mongo": "node src/scripts/migration/export-mongo.js"
  },
  "keywords": [],
  "author": "",
  "engines": {
    "node": "^22.22.0"
  },
