  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.0.5",
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.1.4",
    "pg": "^8.23.0"
  },
  "description": ""
}
