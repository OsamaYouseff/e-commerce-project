# Copy to .env and fill in real values. Never commit .env.

# MongoDB (currently the runtime database; retained during migration/rollback)
MONGO_URL=

# PostgreSQL (required once the backend is switched to PG-backed repositories)
DATABASE_URL=
DATABASE_POOL_MAX=10
DB_SSL=false

# Storage backend: "mongo" (default) or "postgres"
DATA_MODE=mongo

# Authentication
JWT_SEC=

# CORS: comma-separated list of allowed origins (optional; opens all when unset)
CORS_ORIGIN=

# Runtime
NODE_ENV=development
PORT=5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=