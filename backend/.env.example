# Copy to .env and fill in real values. Never commit .env.
#
# The backend runs PostgreSQL-backed repositories only (MongoDB runtime retired).
# The retention/import scripts need the legacy Mongo connection separately, set
# per-command, never here.

# PostgreSQL (required)
DATABASE_URL=
DATABASE_POOL_MAX=10
DB_SSL=false

# Authentication
JWT_SEC=

# CORS: comma-separated list of allowed origins (optional; opens all when unset)
CORS_ORIGIN=

# Runtime
NODE_ENV=development
PORT=5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=